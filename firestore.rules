rules_version = '2';
// Si cambias ADMIN_USUARIO o DOMINIO en js/config.js, cambia también el correo de abajo.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAdmin()  { return logueado() && request.auth.token.email == 'admin@farmacia.app'; }
    function activo() {
      return esAdmin() || (logueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true);
    }

    match /usuarios/{uid} {
      allow read: if esAdmin() || (logueado() && request.auth.uid == uid);
      // Registro propio: solo su ficha, inactiva y pendiente de aprobación
      allow create: if esAdmin() || (logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'dni', 'celular', 'usuario', 'activo', 'pendiente', 'creado'])
        && request.resource.data.activo == false
        && request.resource.data.pendiente == true);
      // Cada usuario puede cambiar solo su foto (pequeña) y quitar la marca de contraseña temporal
      allow update: if esAdmin() || (logueado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto', 'claveTemporal'])
        && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() < 200000
        && request.resource.data.get('claveTemporal', false) == false);
      allow delete: if esAdmin();
    }

    // "Olvidé mi contraseña": cualquiera deja una solicitud; solo el admin la ve y la borra
    match /recuperaciones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['usuario', 'dni', 'creado'])
        && request.resource.data.usuario is string && request.resource.data.usuario.size() <= 40
        && request.resource.data.dni is string && request.resource.data.dni.matches('^[0-9]{8}$');
      allow read, delete: if esAdmin();
    }

    match /medicamentos/{id} {
      allow read: if activo();
      allow create, delete: if esAdmin();
      // El admin edita todo; el resto solo puede DESCONTAR stock (despacho)
      allow update: if esAdmin() || (activo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lotes', 'actualizado'])
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.stock >= 0);
    }

    match /movimientos/{id} {
      allow read: if activo();
      allow create: if esAdmin() || (activo()
        && request.resource.data.tipo == 'despacho'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cantidad > 0);
      allow update, delete: if false; // el historial no se modifica
    }
  }
}
